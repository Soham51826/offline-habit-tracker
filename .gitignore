# ==============================================================================
# Security & Sensitive Credentials (Critical for Public & Private Repositories)
# ==============================================================================
# Environment files & API Keys
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
assets/env/.env
assets/env/.env.*
# Whitelist example/template environment files
!.env.example
!assets/env/.env.example
!*.env.example

# Secret keys, Certificates & Private Tokens
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.cer
*.crt
*.der
*.pub
*.mobileprovision

# Android Signing Configurations & Local SDK paths
key.properties
**/android/key.properties
signing.properties
**/android/signing.properties
local.properties
**/android/local.properties

# Cloud, Firebase & Third-Party Service Credentials
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist
*credentials*.json
*secret*.json
client_secret*.json
service-account*.json
serviceAccountKey*.json
.aws/
.gcp/
firebase-debug.log
.firebase/

# Local Database, User Data & Sensitive Backups
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite3
# Keep required wasm binaries for web database engine
!web/sqlite3.wasm
*.dump
*.backup
*.bak
*habit_backup*.json
*habit_export*.json
*backup*.json

# ==============================================================================
# IDEs, Editors & Operating System Metadata
# ==============================================================================
# Android Studio / IntelliJ IDEA
.idea/
**/.idea/
*.iml
**/*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/
**/.vscode/
!.vscode/extensions.json

# Fleet & other editors
.fleet/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ==============================================================================
# Python Virtual Environments & Caches
# ==============================================================================
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
pip-wheel-metadata/
dist/
build_py/
*.egg-info/
~$*

# ==============================================================================
# Flutter / Dart Build & Ephemeral Files
# ==============================================================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.packages.generated
.pub-preload-cache/
.pub/
build/
**/doc/api/
**/generated_plugin_registrant.dart
flutter_*.png
linked_*.ds
unlinked.ds
unlinked_spec.ds
analysis_benchmark.json
app.*.symbols
coverage/

# Exceptions to above Flutter rules
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages
!/dev/ci/**/Gemfile.lock
!pubspec.lock

# ==============================================================================
# Android Build Files & Tooling
# ==============================================================================
**/android/**/gradle-wrapper.jar
.gradle/
**/.gradle/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/**/GeneratedPluginRegistrant.java
.kotlin/
**/.kotlin/
.cxx/
**/android/.cxx/

